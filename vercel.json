{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include-workspace-root -w @akbadna/core -w @akbadna/mobile",
  "buildCommand": "npm run core:build && npm run export:web -w @akbadna/mobile",
  "outputDirectory": "apps/mobile/dist",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
