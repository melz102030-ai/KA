{
  "name": "@akbadna/rules-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firestore security-rules tests (emulator)",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project akbadna-rules-test \"vitest run\"",
    "test:watch": "firebase emulators:exec --only firestore --project akbadna-rules-test \"vitest\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^12.18.0",
    "firebase-tools": "^13.29.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
