rules_version = '2';

/*
 * Akbadna Firestore rules — free-plan model.
 *
 * The app writes directly from the client (no Cloud Functions required), so
 * these rules carry the authorization logic. When the deployed Functions are
 * enabled (EXPO_PUBLIC_USE_FUNCTIONS=1) they use the Admin SDK and bypass rules;
 * the client paths below still hold for everyone else.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function has(list, v) { return v in list; }
    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function kidData(kidId) { return get(/databases/$(database)/documents/kids/$(kidId)).data; }
    function guardianOf(kidId) {
      return signedIn() && request.auth.uid in kidData(kidId).guardianUids;
    }
    function classData(schoolId, classId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data;
    }
    function teacherOfClass(schoolId, classId) {
      return signedIn() && request.auth.uid in classData(schoolId, classId).teacherIds;
    }
    /**
     * The operator — the one account that may vouch for a school.
     *
     * The list lives in config/operators, which no rule below allows anyone
     * to write. It is created and edited from the Firebase console by whoever
     * owns the project. An operator list the app could edit would be a list an
     * attacker could add themselves to.
     */
    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/operators)
        && request.auth.uid in get(/databases/$(database)/documents/config/operators).data.uids;
    }

    function schoolData(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data;
    }
    function isSchoolAdmin(schoolId) {
      return signedIn() && request.auth.uid in schoolData(schoolId).adminUids;
    }
    // Membership ids are uid_schoolId_role by construction, so standing can be
    // checked with an exists() instead of a query rules cannot run.
    function isStaff(schoolId) {
      return signedIn() && (
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + schoolId + '_teacher'))
        || exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + schoolId + '_school_admin'))
      );
    }
    function codeData(code) { return get(/databases/$(database)/documents/joinCodes/$(code)).data; }
    /**
     * A staff row has to name the code that granted it, and that code has to be
     * real, belong to this school and grant this exact role. Without this the
     * invite chain is only enforced in the app, and anyone writing to Firestore
     * directly could make themselves a teacher at any school in the country.
     */
    function backedByCode(m) {
      return 'viaCode' in m
        && exists(/databases/$(database)/documents/joinCodes/$(m.viaCode))
        && codeData(m.viaCode).schoolId == m.schoolId
        && codeData(m.viaCode).role == m.role;
    }

    // A paired KT37 authenticates with a custom token { role:"device", watchId }.
    function isDevice(watchId) {
      return signedIn() && request.auth.token.role == 'device' && request.auth.token.watchId == watchId;
    }

    /* ── The operator list — console-only, never written from the app ── */
    match /config/operators {
      allow read: if signedIn();
      allow write: if false;
    }

    /* ── Profiles ──────────────────────────────────────────── */
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Members create only their OWN membership rows.
    match /memberships/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      // Parents may enrol themselves; staff may not. A teacher or admin row is
      // accepted only from the person who created the school, or from someone
      // holding a code that grants that very role at that very school.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == 'parent'
            || request.resource.data.role == 'driver'
            || isSchoolAdmin(request.resource.data.schoolId)
            || backedByCode(request.resource.data));
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        // The role is fixed at redemption; editing it would walk around the
        // check above.
        && request.resource.data.role == resource.data.role
        && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    /* ── Onboarding join codes ─────────────────────────────── */
    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if signedIn() && changed(['uses', 'updatedAt']); // usage counter only
      allow delete: if signedIn() && resource.data.createdByUid == request.auth.uid;
    }

    /* ── Org ──────────────────────────────────────────────── */
    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.adminUids
        // A school begins unverified, whatever its founder writes in the field.
        && request.resource.data.status == 'pending';

      /**
       * Two hands on this document.
       *
       * The school's own admins edit everything about it except its standing:
       * name, location, timetable, and the verification file they submit. The
       * one move they may make on `status` is handing that file in for review.
       * Granting standing — verified, suspended — belongs to the operator
       * alone, because a school that can verify itself is not verified at all.
       */
      allow update: if
        (signedIn() && request.auth.uid in resource.data.adminUids
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'submitted'
                  && (resource.data.status == 'pending'
                      || resource.data.status == 'rejected'))))
        || isOperator();
      allow delete: if false;

      match /classes/{classId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid in request.resource.data.teacherIds;
        // teachers/admins edit freely; anyone signed-in may only extend the roster
        allow update: if teacherOfClass(schoolId, classId)
          || (request.auth.uid in get(/databases/$(database)/documents/schools/$(schoolId)).data.adminUids)
          || changed(['studentIds', 'updatedAt']);
        allow delete: if false;
      }

      /**
       * The year, and each child's place in it.
       *
       * Readable by anyone signed in — a parent asking about a year that ended
       * is the whole point of keeping these — but written only by the school's
       * own staff, because this is where promotion and graduation are recorded.
       */
      match /years/{yearId} {
        allow read: if signedIn();
        allow write: if isSchoolAdmin(schoolId) || isStaff(schoolId);

        match /enrolments/{kidId} {
          allow read: if signedIn();
          allow write: if isSchoolAdmin(schoolId) || isStaff(schoolId);
        }
      }

      match /attendanceSessions/{sessionId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && teacherOfClass(schoolId, request.resource.data.classId != null
              ? request.resource.data.classId : resource.data.classId);

        match /records/{kidId} {
          allow read: if signedIn();
          allow write: if signedIn()
            && teacherOfClass(schoolId, request.resource.data.classId);
        }
      }
    }

    /* ── Kids ─────────────────────────────────────────────── */
    match /kids/{kidId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.guardianUids;
      // guardians edit profile fields but never the function/device-owned live block
      allow update: if guardianOf(kidId) && request.resource.data.live == resource.data.live;
      allow delete: if false;

      match /attendanceSummary/{doc} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    /* ── Watches & telemetry ──────────────────────────────── */
    match /watches/{watchId} {
      allow read: if signedIn();
      allow update: if isDevice(watchId)
        && changed(['lastSeenAt', 'batteryPct', 'link', 'lastLocation', 'updatedAt']);
      allow create, delete: if false;

      match /commands/{cmdId} {
        // Who the cue is for, per the document being written.
        function cueKid() { return request.resource.data.kidId; }

        // The watch named in the path must actually be the one paired to that
        // kid. Without this a guardian could aim any device on the system by
        // naming a child they are allowed to write for.
        function watchBelongsToKid() {
          return get(/databases/$(database)/documents/watches/$(watchId)).data.kidId == cueKid();
        }

        function mayCue() {
          return watchBelongsToKid() && (
            guardianOf(cueKid())
            || teacherOfClass(kidData(cueKid()).schoolId, kidData(cueKid()).classId)
          );
        }

        allow read: if isDevice(watchId);
        // A cue always enters the queue unacked: the device alone may say it
        // was delivered or seen.
        allow create: if mayCue()
          && request.resource.data.watchId == watchId
          && request.resource.data.status == 'queued'
          && !('ackedAt' in request.resource.data);
        allow update: if isDevice(watchId) && changed(['status', 'ackedAt']);
        allow delete: if false;
      }
    }
    match /telemetry/{watchId}/packets/{packetId} {
      allow create: if isDevice(watchId);
      allow read, update, delete: if false;
    }
    match /telemetry/{watchId}/{document=**} {
      allow read, write: if false;
    }

    match /rewards/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* ── Messaging ────────────────────────────────────────── */
    match /threads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids;
      allow update: if signedIn() && request.auth.uid in resource.data.participantUids;

      match /messages/{messageId} {
        function thread() { return get(/databases/$(database)/documents/threads/$(threadId)).data; }
        allow read: if signedIn() && request.auth.uid in thread().participantUids;
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in thread().participantUids;
        allow update, delete: if false;
      }
    }

    /* ── Carpool ──────────────────────────────────────────── */
    match /carpoolTrips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.driverUid == request.auth.uid;
      allow update: if signedIn() && resource.data.driverUid == request.auth.uid;

      match /requests/{requestId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid;
        allow update: if signedIn()
          && (resource.data.requesterUid == request.auth.uid
            || get(/databases/$(database)/documents/carpoolTrips/$(tripId)).data.driverUid == request.auth.uid);
      }
    }

    /* ── Wallet ───────────────────────────────────────────── */
    match /walletAccounts/{kidId} {
      allow read: if guardianOf(kidId);
      allow create, update: if guardianOf(kidId)
        && request.resource.data.ownerUid == request.auth.uid;
      match /transactions/{txId} {
        allow read: if guardianOf(kidId);
        allow create: if guardianOf(kidId);
        allow update, delete: if false;
      }
    }

    /* ── Safety ───────────────────────────────────────────── */
    match /geofences/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.scope.kind == 'kid' && guardianOf(request.resource.data.scope.id);
      allow update, delete: if signedIn()
        && resource.data.scope.kind == 'kid' && guardianOf(resource.data.scope.id);
    }
    match /alerts/{id} {
      allow read: if signedIn();
      // a guardian may raise an SOS for their own kid; other alerts are function-made
      allow create: if signedIn()
        && request.resource.data.kind == 'sos'
        && guardianOf(request.resource.data.kidId);
      // acknowledge / resolve
      allow update: if signedIn()
        && changed(['state', 'acknowledgedBy', 'acknowledgedAt', 'resolvedAt', 'updatedAt']);
      allow delete: if false;
    }
    match /contacts/{id} {
      allow read, create, update, delete: if signedIn();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
